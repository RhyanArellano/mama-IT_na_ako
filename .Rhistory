mean(vec_num)
sum(vec_num)
grades <- c(88, 92, 79, 95, 84)
names(grades) <- c("Math", "Science", "English", "History", "PE")
grades[3]
grades[c(1, 4)]
grades[c("Science", "PE")]
grades[-c(1, 4)]
grades[grades >= 85]
grades[10]
